<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
            android:key="input_key_mapping"
            android:title="@string/key_mapping"
            android:summary="@string/key_mapping_summary"
            app:iconSpaceReserved="false" />

    <Preference
        android:key="input_layouts"
        android:title="@string/layouts"
        android:summary="@string/layouts_summary"
        app:iconSpaceReserved="false" />

    <me.magnum.melonds.ui.settings.preferences.SoftwareInputBehaviourPreference
        android:key="soft_input_behaviour"
        android:title="@string/soft_input_behaviour"
        android:summary="%s"
        android:entries="@array/soft_input_behaviour_options"
        android:entryValues="@array/soft_input_behaviour"
        android:defaultValue="hide_system_buttons_when_controller_connected"
        app:fragment="me.magnum.melonds.ui.settings.fragments.SoftInputBehaviourPreferencesFragment"
        app:iconSpaceReserved="false" />

    <SwitchPreference
            android:key="input_touch_haptic_feedback_enabled"
            android:title="@string/vibrate_on_touch"
            app:iconSpaceReserved="false"
            android:defaultValue="true" />

    <!-- Vibration strength can go to 255 but the finer controls are in the lower values. As such, the max value is
         set to 100 -->
    <SeekBarPreference
            android:key="input_touch_haptic_feedback_strength"
            android:title="@string/vibration_strength"
            android:dependency="input_touch_haptic_feedback_enabled"
            app:iconSpaceReserved="false"
            app:updatesContinuously="true"
            android:defaultValue="30"
            app:min="1"
            android:max="100" />

    <SeekBarPreference
            android:key="input_opacity"
            android:title="@string/soft_input_opacity"
            app:iconSpaceReserved="false"
            android:defaultValue="50"
            android:max="100" />

    <!-- [KHMM] camera-stick speed for the KH games. Desktop exposes 1-4 in whole steps
         (an integer bit-shift, each step DOUBLES the speed — too coarse on the RG505);
         we add half-steps and two slower whole steps below the desktop minimum, stored
         as half-units 2-12 = 1.0-6.0 (key renamed from kh_camera_speed when the scale
         changed; the old default speed is this scale's 4). Applies live. -->
    <ListPreference
            android:key="kh_camera_speed_2"
            android:title="@string/kh_camera_sensitivity"
            android:summary="%s"
            android:entries="@array/kh_camera_speed_options"
            android:entryValues="@array/kh_camera_speed_values"
            android:defaultValue="8"
            app:iconSpaceReserved="false" />

    <!-- [KHMM] radial deadzone for the touch movement/camera sticks, percent of the stick
         radius. Applies live. -->
    <ListPreference
            android:key="kh_stick_deadzone"
            android:title="@string/kh_stick_deadzone"
            android:summary="%s"
            android:entries="@array/kh_stick_deadzone_options"
            android:entryValues="@array/kh_stick_deadzone_values"
            android:defaultValue="10"
            app:iconSpaceReserved="false" />
</PreferenceScreen>