<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- [KHMM] The renderer setting is gone: this app always uses OpenGL (the KH composite
         is OpenGL-only by design; software/compute silently disabled it). Threaded rendering
         (software-only) and the DSi camera (no DSi mode, and neither KH game uses it) were
         removed with it. -->
    <ListPreference
            android:key="video_internal_resolution"
            android:title="@string/internal_resolution"
            android:summary="%s"
            app:iconSpaceReserved="false"
            android:entries="@array/video_internal_resolution_options"
            android:entryValues="@array/video_internal_resolution_values"
            android:defaultValue="1"/>

    <!-- [KHMM] master toggle for the KH Melon Mix single-screen enhanced-graphics path -->
    <SwitchPreference
            android:key="enable_enhanced_graphics"
            android:title="@string/enhanced_graphics"
            android:summary="@string/enhanced_graphics_summary"
            app:iconSpaceReserved="false"
            android:defaultValue="true" />

    <!-- [KHMM] desktop's DisableSingleScreenMode config, surfaced inverted as "Dual screen
         mode": on keeps bottom-screen content on the native bottom screen for dual-screen
         devices (e.g. AYN Thor). Old kh_single_screen_mode values are carried over inverted
         by a lazy one-timer in SharedPreferencesSettingsRepository (the versioned Migrator
         never runs in this fork) -->
    <SwitchPreference
            android:key="kh_dual_screen_mode"
            android:title="@string/kh_dual_screen_mode"
            android:summary="@string/kh_dual_screen_mode_summary"
            android:dependency="enable_enhanced_graphics"
            app:iconSpaceReserved="false"
            android:defaultValue="false" />

    <!-- [KHMM] read-only status row: whether the Days HD cutscene pack is installed and
         where it belongs, mirroring the music-pack rows in the audio settings -->
    <Preference
            android:key="kh_cutscene_pack_status"
            android:title="@string/kh_cutscene_pack"
            android:dependency="enable_enhanced_graphics"
            android:selectable="false"
            app:iconSpaceReserved="false" />

    <!-- [KHMM] subtitles over HD replacement cutscenes (desktop DisableSubtitles config) -->
    <SwitchPreference
            android:key="kh_show_subtitles"
            android:title="@string/kh_show_subtitles"
            android:summary="@string/kh_show_subtitles_summary"
            android:dependency="enable_enhanced_graphics"
            app:iconSpaceReserved="false"
            android:defaultValue="true" />

    <ListPreference
            android:key="video_filtering"
            android:title="@string/filter"
            android:summary="%s"
            app:iconSpaceReserved="false"
            android:entries="@array/video_filtering_options"
            android:entryValues="@array/video_filtering_values"
            android:defaultValue="none"/>

    <ListPreference
            android:key="fps_counter_position"
            android:title="@string/fps_counter_position"
            android:summary="%s"
            app:iconSpaceReserved="false"
            android:entries="@array/fps_counter_position_options"
            android:entryValues="@array/fps_counter_position_values"
            android:defaultValue="hidden" />

</PreferenceScreen>