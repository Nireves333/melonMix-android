<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.magnum.melonds.ui.settings.preferences.StoragePickerPreference
            android:key="rom_search_dirs"
            android:title="@string/rom_search_directory"
            app:iconSpaceReserved="false"
            app:selection="multi"
            app:type="directory"
            app:permissions="read_write"
            app:persistPermissions="true" />

    <!-- [KHMM] Settings curation: icon filtering (cosmetic knob for a 2-game list) and the
         ROM-cache size/clear controls (only used for zipped ROMs) were removed; the cache
         size is pinned internally to the old 1GB default. -->
</PreferenceScreen>