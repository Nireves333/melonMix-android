<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.magnum.melonds.ui.settings.preferences.StoragePickerPreference
            android:key="rom_search_dirs"
            android:title="@string/rom_search_directory"
            app:iconSpaceReserved="false"
            app:selection="multi"
            app:type="directory"
            app:permissions="read_write"
            app:persistPermissions="true" />

    <!-- [KHMM] Settings curation: icon filtering (cosmetic knob for a 2-game list) and the
         ROM-cache size/clear controls (only used for zipped ROMs) were removed; the cache
         size is pinned internally to the old 1GB default. -->

    <!-- [KHMM] Relocatable asset folder: the Melon Mix asset packs (HD cutscenes, music,
         subtitles) live in a user-visible shared-storage folder. Summaries and visibility
         are managed in RomsPreferencesFragment. -->
    <PreferenceCategory
            android:title="@string/kh_assets_category"
            app:iconSpaceReserved="false">

        <Preference
                android:key="kh_assets_folder"
                android:title="@string/kh_assets_folder"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="kh_assets_grant_access"
                android:title="@string/kh_assets_grant_access"
                android:summary="@string/kh_assets_grant_access_summary"
                app:iconSpaceReserved="false" />

        <Preference
                android:key="kh_assets_migrate"
                android:title="@string/kh_assets_migrate"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>