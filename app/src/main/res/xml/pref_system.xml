<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- [KHMM] Settings curation: the firmware subscreen collapsed to just the language —
         the one firmware setting the KH games actually surface (Melon Mix menus, HD-cutscene
         subtitles, and dialog localization all follow it). Nickname/message/colour/birthday/
         MAC were DS personalization neither game uses; the custom-BIOS screen (with its
         untested-on-KH DSi console type) and the JIT footgun are pinned internally. -->
    <ListPreference
            android:key="firmware_settings_language"
            android:title="@string/kh_game_language"
            android:summary="%s"
            app:iconSpaceReserved="false"
            android:entries="@array/firmware_settings_language_options"
            android:entryValues="@array/firmware_settings_language_values"
            android:defaultValue="1" />

    <Preference
            android:key="backup_internal_layout"
            android:title="@string/backup_internal_layout"
            app:isPreferenceVisible="@bool/settings_backup_restore_enabled"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="backup_external_layout"
            android:title="@string/backup_external_layout"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="restore_internal_layout"
            android:title="@string/restore_internal_layout"
            app:isPreferenceVisible="@bool/settings_backup_restore_enabled"
            app:iconSpaceReserved="false" />

    <Preference
            android:key="restore_external_layout"
            android:title="@string/restore_external_layout"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />
</PreferenceScreen>